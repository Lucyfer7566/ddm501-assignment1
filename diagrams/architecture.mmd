---
config:
  theme: base
  look: classic
  fontFamily: Arial
  themeVariables:
    fontFamily: Arial
    fontSize: 22px
  block:
    padding: 12
---
%% Matching letters are directed transfers between bands (see Figure 1 caption).
%% A: object store and CMMS -> training history.
%% B: approved deployment/rollback -> serving bundle.
%% C: validated operational data -> recent inference window.
%% D: data/serving health and matured outcomes -> monitoring.
%% E: approved Airflow retraining -> batch validation.
%% F: predictions, episodes and workflow actions -> operational store.
block-beta
    columns 4
    SENS["MOTOR DATA<br/>sensors (OT)"] EDGE["Edge gateway<br/>features + buffer"] BROKER["MQTT 5 broker<br/>TLS + ACLs"] INGEST["Dedup + ingest<br/>persist raw data"]
    CMMS["CMMS / EAM<br/>work orders /<br/>outcomes (A, D)"] OPS["Time-series store<br/>recent data (C)<br/>risk / actions (F)"] ONLINEVAL["Validate data"] LAKE["Object store<br/>raw / quarantine<br/>curated (A, D)"]
    HISTORY["TRAINING (A)<br/>sensor history<br/>+ outcomes"] BATCHVAL["Validate + curate<br/>data + labels (E)"] FEATTRAIN["Preprocess<br/>shared features"] TRAINER["Train XGBoost<br/>binary classifier"]
    space DEPLOY["Human approval<br/>shadow / deploy<br/>rollback (B)"] REGISTRY["MLflow registry<br/>versioned bundle"] EVAL["Evaluate gates<br/>independent"]
    space:4
    RECENT["INFERENCE (C)<br/>six-hour window"] ONLINEFEAT["Shared features<br/>validity gate"] SERVE["Model cache (B)<br/>approved bundle"] PROB["24-hour failure<br/>risk probability (D)"]
    INSUFFICIENT["Insufficient Data<br/>reason / health (D)"] PRED["Persist prediction<br/>immutable log"] CLASS["Normal /<br/>High Risk"] POLICY["Risk policy<br/>thresholds<br/>hysteresis / dedup"]
    DASH["Dashboard (F, D)<br/>ack / assign /<br/>investigate"] space ALERT["High Risk only<br/>durable episode"] space
    MON["MONITORING (D)<br/>service / data /<br/>model / outcome"] SIGNAL["Drift / quality /<br/>performance<br/>human review"] RETRAIN["Approve retrain<br/>Airflow run (E)<br/>monthly / trigger"] space

    SENS --> EDGE
    EDGE --> BROKER
    BROKER --> INGEST
    INGEST --> ONLINEVAL
    INGEST --> LAKE
    ONLINEVAL --> OPS
    ONLINEVAL -.-> LAKE
    OPS <--> CMMS
    HISTORY --> BATCHVAL
    BATCHVAL --> FEATTRAIN
    FEATTRAIN --> TRAINER
    TRAINER --> EVAL
    EVAL -.-> BATCHVAL
    EVAL --> REGISTRY
    REGISTRY --> DEPLOY
    RECENT --> ONLINEFEAT
    ONLINEFEAT -.-> INSUFFICIENT
    ONLINEFEAT --> SERVE
    SERVE --> PROB
    PROB --> POLICY
    POLICY --> CLASS
    CLASS --> PRED
    CLASS --> ALERT
    ALERT --> DASH
    INSUFFICIENT --> DASH
    PRED --> DASH
    MON --> SIGNAL
    SIGNAL --> RETRAIN

    classDef data fill:#edf4fc,stroke:#356a9a,color:#172b3a
    classDef train fill:#edf7ef,stroke:#347a40,color:#173c20
    classDef infer fill:#f4eefb,stroke:#74449a,color:#302044
    classDef feedback fill:#fff0ef,stroke:#9a4545,color:#4b2222
    class SENS,EDGE,BROKER,INGEST,ONLINEVAL,OPS,LAKE,CMMS data
    class HISTORY,BATCHVAL,FEATTRAIN,TRAINER,EVAL,REGISTRY,DEPLOY train
    class RECENT,ONLINEFEAT,SERVE,PROB,POLICY,CLASS,PRED,DASH,INSUFFICIENT,ALERT infer
    class MON,SIGNAL,RETRAIN feedback
